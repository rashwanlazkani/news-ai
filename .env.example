# ─── Local development only ────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to version control.
# In production, all secrets are read from AWS SSM Parameter Store.

NEWS_API_KEY=your-api-key-here

# DynamoDB local (used with serverless-offline)
PREFERENCES_TABLE=news-ai-preferences-dev
AWS_REGION=eu-north-1
